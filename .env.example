GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
SEARCH_API_KEY=
SEARCH_PROVIDER=tavily
# Domain exclusions include descendants; host exclusions match only that host (www normalized).
# Hosted creator subdomains remain eligible unless explicitly excluded.
SEARCH_EXCLUDED_DOMAINS=mapquest.com,cbinsights.com,onlinejobs.ph,tavily.com,google.com,bing.com,yahoo.com
SEARCH_EXCLUDED_HOSTS=teachable.com,thinkific.com,ruzuku.com,kajabi.com,podia.com,learnworlds.com
SEARCH_RESULTS_PER_QUERY=10
DATABASE_PATH=data/outreach.sqlite3
DRY_RUN=true
PAUSED=true
POSTAL_ADDRESS=
# Human verification of a valid physical address; a nonempty string alone is insufficient.
POSTAL_ADDRESS_CONFIRMED=false
DNS_TIMEOUT_SECONDS=5
GMAIL_ACCOUNT=
OWNER_TEST_ADDRESSES=
GMAIL_CLIENT_FILE=credentials.json
DAILY_LIMIT=15
# Days to wait after the first email before a follow-up may be drafted (3-30).
FOLLOWUP_WAIT_DAYS=5
